# Copy to .env and adjust as needed

# Simulator host
# Mac/Windows: host.docker.internal (default, no change needed)
# Linux:       127.0.0.1 (host-gateway handles it via extra_hosts)
IFSSIM_HOST=host.docker.internal
IFSSIM_PORT=41451

# Mission configuration
MISSION_NAME=trackdrive
TRACK_NAME=A

# ROS2 domain (change if multiple stacks run on the same network)
ROS_DOMAIN_ID=0

# Set to true to start the full autonomous pipeline (slam, path_planning, control)
# false = bridge only (use for manual driving / topic verification)
PIPELINE_ENABLED=false

# Absolute path to Content/tracks on the HOST machine (used by backend to tell UE5 where to load tracks from)
# Default: auto-detected via ${PWD}/Content/tracks when running docker compose from the repo root
# Override only if you run docker compose from a different directory
# UE5_TRACKS_DIR=/absolute/path/to/IFSSIM/Content/tracks

# Mission Control — optional API key authentication.
#
# When IFSSIM_MC_API_KEY is set, the backend requires an X-API-Key
# header on every mutating endpoint (sim control, event control, RES,
# pipeline, track load/generate/delete) and the /ws/telemetry
# WebSocket handshake. Read-only status endpoints stay open so a
# passive dashboard can still monitor without the key.
#
# When left empty, the backend logs a single warning to stderr and
# serves everything unauthenticated. Fine for closed-network local
# dev — DO NOT use this on untrusted wifi.
#   openssl rand -hex 24   # good source of a 48-char token
IFSSIM_MC_API_KEY=

# CORS allow-list (comma-separated). Defaults to the docker-compose-
# published frontend (:3000). Override only if an external tool needs
# to reach the backend directly.
IFSSIM_MC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
