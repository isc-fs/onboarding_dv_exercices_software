  "userNodes": {
    "map_to_odom_norm": {
      "name": "map_to_odom_norm",
      "sourceCode": "// Compute ||map \u2192 odom|| translation magnitude from /tf.\n//\n// `map \u2192 odom` is SLAM's drift-correction transform: how far it has had\n// to drag the odom frame to keep dead-reckoning agreeing with the cone\n// map. Magnitude grows whenever OdometryFilter accumulates error\n// faster than per-scan SLAM corrections can absorb. A healthy lap\n// stays sub-metre; tens of metres means dead-reckoning is the\n// upstream problem (#391 \u2014 vy contamination, gyro bias).\n//\n// Output: /studio_script/map_to_odom_norm (m, Float32-shaped).\n\nimport { Input } from \"./types\";\n\ntype Output = { data: number };\n\nexport const inputs = [\"/tf\"];\nexport const output = \"/studio_script/map_to_odom_norm\";\n\nexport default function node(\n  event: Input<\"/tf\">,\n): Output | undefined {\n  for (const t of event.message.transforms) {\n    if (t.header.frame_id === \"map\" && t.child_frame_id === \"odom\") {\n      const tx = t.transform.translation.x;\n      const ty = t.transform.translation.y;\n      // 2D vehicle \u2014 z translation is essentially zero, omit it from\n      // the norm so the plot reads as planar drift.\n      return { data: Math.hypot(tx, ty) };\n    }\n  }\n  return undefined;\n}\n"
    },
    "yaw_drift_deg": {
      "name": "yaw_drift_deg",
      "sourceCode": "// Compute integrated yaw drift (Filter \u2212 GT) in degrees.\n//\n// Both /odom and /testing_only/odom publish a 3D pose; we extract yaw from\n// the quaternion, anchor each stream at its first sample (so the 90\u00b0\n// world-frame offset between SLAM's local frame and GT's world frame is\n// taken out), and emit the wrapped difference in degrees.\n//\n// This is the metric that compounds into bad path planning and bad\n// control \u2014 yaw RATE can look identical at every instant while integrated\n// yaw is dozens of degrees off.\n//\n// Output: /studio_script/yaw_drift_deg (deg, Float32-shaped).\n\nimport { Input } from \"./types\";\n\ntype Output = { data: number };\n\nexport const inputs = [\"/odom\", \"/testing_only/odom\"];\nexport const output = \"/studio_script/yaw_drift_deg\";\n\n// Per-script-instance anchor state. Set on the first message of each\n// stream; subsequent messages are deltas relative to these.\nlet odomAnchor: number | undefined = undefined;\nlet gtAnchor: number | undefined = undefined;\nlet latestOdom: number | undefined = undefined;\nlet latestGt: number | undefined = undefined;\n\nfunction quatYaw(q: { w: number; x: number; y: number; z: number }): number {\n  return Math.atan2(\n    2 * (q.w * q.z + q.x * q.y),\n    1 - 2 * (q.y * q.y + q.z * q.z),\n  );\n}\n\nfunction wrapPi(a: number): number {\n  return ((a + Math.PI) % (2 * Math.PI) + 2 * Math.PI) % (2 * Math.PI) - Math.PI;\n}\n\nexport default function node(\n  event: Input<\"/odom\"> | Input<\"/testing_only/odom\">,\n): Output | undefined {\n  const yaw = quatYaw(event.message.pose.pose.orientation);\n  if (event.topic === \"/odom\") {\n    if (odomAnchor === undefined) odomAnchor = yaw;\n    latestOdom = wrapPi(yaw - odomAnchor);\n  } else {\n    if (gtAnchor === undefined) gtAnchor = yaw;\n    latestGt = wrapPi(yaw - gtAnchor);\n  }\n  if (latestOdom === undefined || latestGt === undefined) return undefined;\n  const err = wrapPi(latestOdom - latestGt);\n  return { data: (err * 180) / Math.PI };\n}\n"
    }
  },
