{
  "configById": {

    "Tab!main": {
      "activeTabIdx": 0,
      "tabs": [
        {
          "title": "Control",
          "layout": {
            "direction": "row",
            "first": "3D!control_map",
            "second": {
              "direction": "row",
              "first": {
                "direction": "column",
                "first": {
                  "direction": "row",
                  "first": "Plot!steering",
                  "second": "Plot!speed",
                  "splitPercentage": 50
                },
                "second": {
                  "direction": "column",
                  "first": {
                    "direction": "row",
                    "first": "Plot!throttle_brake",
                    "second": "Plot!imu_accel",
                    "splitPercentage": 50
                  },
                  "second": {
                    "direction": "column",
                    "first": "Plot!yaw_rate",
                    "second": "Plot!cone_count",
                    "splitPercentage": 50
                  },
                  "splitPercentage": 50
                },
                "splitPercentage": 25
              },
              "second": "RawMessages!cmd",
              "splitPercentage": 75
            },
            "splitPercentage": 35
          }
        },
        {
          "title": "SLAM",
          "layout": {
            "direction": "row",
            "first": "3D!slam_map",
            "second": {
              "direction": "column",
              "first": "Plot!cone_count_slam",
              "second": {
                "direction": "column",
                "first": "Plot!pose_drift",
                "second": "RawMessages!conos",
                "splitPercentage": 50
              },
              "splitPercentage": 33
            },
            "splitPercentage": 70
          }
        },
        {
          "title": "IMU",
          "layout": {
            "direction": "row",
            "first": "3D!imu_view",
            "second": {
              "direction": "column",
              "first": "Plot!imu_accel_xyz",
              "second": {
                "direction": "column",
                "first": "Plot!angular_vel",
                "second": "Plot!speed_imu",
                "splitPercentage": 50
              },
              "splitPercentage": 33
            },
            "splitPercentage": 25
          }
        }
      ]
    },

