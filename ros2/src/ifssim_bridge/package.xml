<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ifssim_bridge</name>
  <version>1.0.0</version>
  <description>ROS2 bridge for the IFSSIM Formula Student Driverless Simulator.
  Connects to the IFSSIM TCP RPC server and publishes sensor data as ROS2 topics.</description>
  <maintainer email="team@isc-fs.org">ISC Formula Student</maintainer>
  <license>GPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>fs_msgs</depend>
</package>
